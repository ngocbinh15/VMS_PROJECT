@{
    ViewData["Title"] = "Quản Trị Hệ Thống";
    Layout = "_MainLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/dashboard.css" asp-append-version="true">
    <style>
        /* Override shared layout body padding for admin sidebar layout */
        body { padding-top: 64px !important; }
        .glass-nav { height: 64px; padding: 8px 0 !important; }
    </style>
}

@section NavbarExtra {
    <!-- <a class="nav-link text-secondary fw-semibold small d-none d-md-inline" href="@Url.Action("Dashboard", "Kho")">
        <i class="bi bi-box-seam-fill me-1"></i>Kho
    </a>
    <a class="nav-link text-secondary fw-semibold small d-none d-md-inline" href="@Url.Action("Dashboard", "Phao")">
        <i class="bi bi-droplet-fill me-1"></i>Phao
    </a> -->
}

<!-- Toast container -->
<div id="toastContainer" class="toast-container-custom"></div>

<!-- ═══ SIDEBAR ═══ -->
<aside class="admin-sidebar">
    <nav class="ap-sidebar-nav">

        <a class="ap-nav-item active nav-link" data-section="sectionOverview" href="#">
            <i class="bi bi-speedometer2"></i>
            <span>Tổng Quan</span>
        </a>

        <div class="ap-nav-divider">Quản lý</div>

        <a class="ap-nav-item nav-link" data-section="sectionTaiKhoan" href="#">
            <i class="bi bi-people"></i>
            <span>Quản Lý Tài Khoản</span>
        </a>

        <a class="ap-nav-item nav-link" data-section="sectionVatLieu" href="#">
            <i class="bi bi-box-seam"></i>
            <span>Quản Lý Vật Liệu</span>
        </a>

        <a class="ap-nav-item nav-link" data-section="sectionKho" href="#">
            <i class="bi bi-building"></i>
            <span>Quản Lý Kho</span>
        </a>

        <a class="ap-nav-item nav-link d-flex align-items-center justify-content-between" data-section="sectionDuyetPhieu" href="#">
            <div>
                <i class="bi bi-check2-square"></i>
                <span>Duyệt Phiếu Giao Dịch</span>
            </div>
            <span class="badge bg-warning text-dark ms-2" id="badgePendingCount" style="display:none">0</span>
        </a>

        <div class="ap-nav-divider">Hệ thống</div>

        <a class="ap-nav-item nav-link" data-section="sectionSystemLog" href="#">
            <i class="bi bi-journal-text"></i>
            <span>Nhật Ký Nhập – Xuất – Điều Chuyển</span>
        </a>

        <div class="ap-nav-divider">Liên kết</div>

        <!-- <a class="ap-nav-item" href="@Url.Action("Dashboard", "Kho")">
            <i class="bi bi-box-seam-fill"></i>
            <span>Đi tới Kho</span>
        </a>

        <a class="ap-nav-item" href="@Url.Action("Dashboard", "Phao")">
            <i class="bi bi-droplet-fill"></i>
            <span>Đi tới Phao</span>
        </a> -->

        <a class="ap-nav-item" href="@Url.Action("QuanLyPhao", "Admin")">
            <i class="bi bi-gear-wide-connected"></i>
            <span>Admin Phao</span>
        </a>

    </nav>
</aside>

<!-- ═══ MAIN CONTENT ═══ -->
<main class="admin-main">

    <!-- ── SECTION: Tổng Quan ── -->
    <section id="sectionOverview" class="admin-section active">
        <div class="admin-page-header">
            <h4><i class="bi bi-speedometer2 me-2 text-primary"></i>Tổng Quan</h4>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="stat-card" style="cursor:pointer" onclick="goToSection('sectionTaiKhoan')">
                    <div class="stat-icon blue"><i class="bi bi-people-fill"></i></div>
                    <div>
                        <div class="stat-value" id="statTotalAccounts">-</div>
                        <div class="stat-label">Tổng tài khoản</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon green"><i class="bi bi-person-check-fill"></i></div>
                    <div>
                        <div class="stat-value" id="statActiveAccounts">-</div>
                        <div class="stat-label">Tài khoản hoạt động</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card" style="cursor:pointer" onclick="goToSection('sectionVatLieu')">
                    <div class="stat-icon amber"><i class="bi bi-box-seam-fill"></i></div>
                    <div>
                        <div class="stat-value" id="statTotalMaterials">-</div>
                        <div class="stat-label">Tổng vật liệu</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon red"><i class="bi bi-exclamation-triangle-fill"></i></div>
                    <div>
                        <div class="stat-value text-danger" id="statLowStockCount">0</div>
                        <div class="stat-label">Cảnh báo tồn tối thiểu</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Bảng Cảnh Báo Tồn Kho Tối Thiểu ── -->
        <div class="admin-card mb-4">
            <div class="d-flex align-items-center justify-content-between px-3 py-3 border-bottom">
                <h5 class="mb-0 fw-bold text-danger fs-6">
                    <i class="bi bi-exclamation-octagon-fill me-2"></i>Danh Sách Vật Tư Chạm Mức Tồn Kho Tối Thiểu
                </h5>
                <span class="badge bg-danger rounded-pill" id="badgeLowStockCount">0 cảnh báo</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle custom-table mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th class="ps-3">Mã VL</th>
                            <th>Tên Vật Liệu</th>
                            <th class="text-center">ĐVT</th>
                            <th>Kho Chứa</th>
                            <th class="text-end">Tồn Thực Tế</th>
                            <th class="text-end">Mức Tối Thiểu</th>
                            <th class="text-center">Cấp Độ Cảnh Báo</th>
                        </tr>
                    </thead>
                    <tbody id="overviewLowStockTableBody">
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Đang kiểm tra tồn kho...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="admin-card">
                    <div class="card-body text-center py-4">
                        <div class="stat-icon blue mx-auto mb-3"><i class="bi bi-box-seam-fill"></i></div>
                        <h5 class="fw-bold">Quản Lý Kho</h5>
                        <p class="text-muted small mb-3">Quản lý vật liệu, tồn kho, nhập xuất kho</p>
                        <a href="@Url.Action("Dashboard", "Kho")" class="btn btn-primary btn-sm rounded-pill px-4">
                            <i class="bi bi-arrow-right-circle me-1"></i>Truy cập
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="admin-card">
                    <div class="card-body text-center py-4">
                        <div class="stat-icon cyan mx-auto mb-3">
                            <i class="bi bi-box-seam-fill"></i>
                        </div>
                        <h5 class="fw-bold">Quản Lý Phao</h5>
                        <p class="text-muted small mb-3">Quản lý phao báo hiệu, tuyến luồng, vị trí phao</p>
                        <a href="@Url.Action("Dashboard", "Phao")"
                           class="btn btn-info btn-sm rounded-pill px-4 text-white">
                            <i class="bi bi-arrow-right-circle me-1"></i>Truy cập
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ── SECTION: Quản Lý Tài Khoản ── -->
    <section id="sectionTaiKhoan" class="admin-section">
        <div class="admin-page-header">
            <h4><i class="bi bi-people me-2 text-primary"></i>Quản Lý Tài Khoản</h4>
            <button class="btn btn-primary btn-sm rounded-pill px-3" onclick="openCreateTaiKhoan()">
                <i class="bi bi-plus-lg me-1"></i>Tạo Tài Khoản
            </button>
        </div>

        <div class="admin-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th class="text-center" style="width:45px">#</th>
                                <th>Tên Đăng Nhập</th>
                                <th>Họ Tên</th>
                                <th>Email</th>
                                <th>SĐT</th>
                                <th>Vai Trò</th>
                                <th>Trạng Thái</th>
                                <th style="width:170px">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody id="taiKhoanTableBody">
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">Đang tải...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>

    <!-- ── SECTION: Quản Lý Vật Liệu ── -->
    <section id="sectionVatLieu" class="admin-section">
        <div class="admin-page-header">
            <h4><i class="bi bi-box-seam me-2 text-primary"></i>Quản Lý Vật Liệu</h4>
            <div class="d-flex gap-2 align-items-center">
                <input type="text" class="form-control form-control-sm" id="vatLieuSearchInput"
                       placeholder="Tìm kiếm vật liệu..." style="width:220px; border-radius:8px">
                <button class="btn btn-primary btn-sm rounded-pill px-3" onclick="openCreateVatLieu()">
                    <i class="bi bi-plus-lg me-1"></i>Thêm Vật Tư
                </button>
            </div>
        </div>

        <div class="admin-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th class="text-center" style="width:45px">#</th>
                                <th>Mã VL</th>
                                <th>Tên Vật Liệu</th>
                                <th>Nhóm</th>
                                <th>ĐVT</th>
                                <th class="text-end">Đơn Giá</th>
                                <th class="text-end">Mức Tối Thiểu</th>
                                <th>Trạng Thái</th>
                                <th style="width:100px">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody id="vatLieuTableBody">
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">Đang tải...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>

    <!-- ── SECTION: Quản Lý Kho ── -->
    <section id="sectionKho" class="admin-section">
        <div class="admin-page-header">
            <h4><i class="bi bi-building me-2 text-primary"></i>Quản Lý Kho</h4>
            <button class="btn btn-primary btn-sm rounded-pill px-3" onclick="openCreateKho()">
                <i class="bi bi-plus-lg me-1"></i>Thêm Kho
            </button>
        </div>

        <div class="admin-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th class="text-center" style="width:45px">STT</th>
                                <th>Tên Kho</th>
                                <th>Ghi Chú</th>
                                <th style="width:180px">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody id="khoTableBody">
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">Đang tải...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>

    <!-- ── SECTION: Duyệt Phiếu Giao Dịch ── -->
    <section id="sectionDuyetPhieu" class="admin-section">
        <div class="admin-page-header">
            <h4><i class="bi bi-check2-square me-2 text-warning"></i>Phê Duyệt Phiếu Giao Dịch Kho</h4>
            <button class="btn btn-outline-primary btn-sm" onclick="loadPhieuChoDuyet()">
                <i class="bi bi-arrow-clockwise me-1"></i>Làm mới
            </button>
        </div>

        <div class="admin-card">
            <div class="table-responsive">
                <table class="table table-hover align-middle custom-table mb-0">
                    <thead>
                        <tr>
                            <th>Mã Phiếu</th>
                            <th>Loại Giao Dịch</th>
                            <th>Kho Liên Quan</th>
                            <th>Người Lập</th>
                            <th>Ngày Tạo</th>
                            <th>Mô Tả / Lý Do</th>
                            <th class="text-end">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody id="pendingTicketsTableBody">
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Đang tải danh sách phiếu chờ duyệt...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- ── SECTION: Nhật Ký Nhập – Xuất – Điều Chuyển ── -->
    <section id="sectionSystemLog" class="admin-section">
        <div class="admin-page-header">
            <h4><i class="bi bi-journal-text me-2 text-primary"></i>Nhật Ký Nhập – Xuất – Điều Chuyển</h4>
        </div>

        <!-- Filters -->
        <div class="filter-bar">
            <div>
                <label class="form-label">Từ ngày</label>
                <input type="date" class="form-control form-control-sm" id="logTuNgay" style="width:150px">
            </div>
            <div>
                <label class="form-label">Đến ngày</label>
                <input type="date" class="form-control form-control-sm" id="logDenNgay" style="width:150px">
            </div>
            <div>
                <label class="form-label">Kho</label>
                <select class="form-select form-select-sm" id="logKho" style="width:160px">
                    <option value="">Tất cả kho</option>
                </select>
            </div>
            <div>
                <label class="form-label">Loại phiếu</label>
                <select class="form-select form-select-sm" id="logLoaiPhieu" style="width:150px">
                    <option value="">Tất cả</option>
                    <option value="NHAP_KHO">Nhập kho</option>
                    <option value="XUAT_KHO">Xuất kho</option>
                    <option value="CHUYEN_KHO">Chuyển kho</option>
                </select>
            </div>
            <div>
                <label class="form-label">Trạng thái</label>
                <select class="form-select form-select-sm" id="logTrangThai" style="width:140px">
                    <option value="">Tất cả</option>
                    <option value="Hoàn thành">Hoàn thành</option>
                    <option value="CHO_DUYET">Chờ duyệt</option>
                    <option value="Từ chối">Từ chối</option>
                </select>
            </div>
            <div>
                <label class="form-label">Tìm vật tư</label>
                <input type="text" class="form-control form-control-sm" id="logSearchVatLieu" placeholder="Tên/mã vật tư..." style="width:160px">
            </div>
            <div class="d-flex gap-1 align-items-end">
                <button class="btn btn-primary btn-sm" onclick="loadSystemLog(1)">
                    <i class="bi bi-search me-1"></i>Lọc
                </button>
                <button class="btn btn-outline-secondary btn-sm" onclick="resetLogFilters()">
                    <i class="bi bi-x-lg me-1"></i>Xóa lọc
                </button>
            </div>
        </div>

        <div class="admin-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Mã Phiếu</th>
                                <th>Loại</th>
                                <th>Kho</th>
                                <th>Trạng Thái</th>
                                <th>Người Thực Hiện</th>
                                <th>Ngày</th>
                                <th class="text-center">Số VT</th>
                                <th style="width:80px"></th>
                            </tr>
                        </thead>
                        <tbody id="systemLogTableBody">
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">Đang tải...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="admin-pagination px-3 pb-2" id="logPagination"></div>
            </div>
        </div>
    </section>

</main>

<!-- ═══ MODAL: Tài Khoản (Create / Edit) ═══ -->
<div class="modal fade" id="taiKhoanModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="formTaiKhoanTitle">Tạo Tài Khoản Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="formTaiKhoanId">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Tên Đăng Nhập <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="formTenDangNhap" maxlength="50">
                </div>
                <div class="mb-3" id="formMatKhauGroup">
                    <label class="form-label fw-semibold">Mật Khẩu <span class="text-danger">*</span></label>
                    <input type="password" class="form-control" id="formMatKhau">
                    <small class="text-muted">Tối thiểu 6 ký tự</small>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Họ Tên <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="formHoTen" maxlength="200">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Email</label>
                    <input type="email" class="form-control" id="formEmail" maxlength="200">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Số Điện Thoại</label>
                    <input type="text" class="form-control" id="formSoDienThoai" maxlength="20">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Vai Trò <span class="text-danger">*</span></label>
                    <select class="form-select" id="formVaiTroId">
                        <option value="">-- Chọn vai trò --</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-primary btn-sm" onclick="saveTaiKhoan()">
                    <i class="bi bi-check-lg me-1"></i>Lưu
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══ MODAL: Reset Password ═══ -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Reset Mật Khẩu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="resetPasswordTaiKhoanId">
                <p class="small text-muted mb-2">Tài khoản: <strong id="resetPasswordUsername"></strong></p>
                <div class="mb-2">
                    <label class="form-label fw-semibold">Mật Khẩu Mới <span class="text-danger">*</span></label>
                    <input type="password" class="form-control" id="resetPasswordInput">
                    <small class="text-muted">Tối thiểu 6 ký tự</small>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-warning btn-sm text-white" onclick="doResetPassword()">
                    <i class="bi bi-key me-1"></i>Reset
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══ MODAL: Edit Vật Liệu ═══ -->
<div class="modal fade" id="vatLieuModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editVatLieuTitle">Sửa Vật Liệu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editVatLieuId">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Mã Vật Liệu <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editMaVatLieu" maxlength="50">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Tên Vật Liệu <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editTenVatLieu" maxlength="200">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Nhóm Vật Tư <span class="text-danger">*</span></label>
                        <select class="form-select" id="editNhomVatLieu">
                            <option value="">-- Chọn nhóm --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Đơn Vị Tính <span class="text-danger">*</span></label>
                        <select class="form-select" id="editDonViTinh">
                            <option value="">-- Chọn ĐVT --</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Đơn Giá (VNĐ) <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="editDonGia" min="0" step="1">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Mức Tối Thiểu</label>
                        <input type="number" class="form-control" id="editMucToiThieu" min="0" step="1">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Mức Tối Đa</label>
                        <input type="number" class="form-control" id="editMucToiDa" min="0" step="1">
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Trạng Thái</label>
                        <select class="form-select" id="editTrangThai">
                            <option value="Đang sử dụng">Đang sử dụng</option>
                            <option value="Không sử dụng">Không sử dụng</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Ghi Chú / Mô Tả</label>
                        <textarea class="form-control" id="editMoTa" rows="2"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-primary btn-sm" onclick="saveVatLieu()">
                    <i class="bi bi-check-lg me-1"></i>Lưu
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══ MODAL: Thêm Vật Tư Mới (Admin) ═══ -->
<div class="modal fade" id="createVatLieuModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Thêm Vật Tư Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Mã Vật Liệu <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="createVl_MaVatLieu" maxlength="50" placeholder="VD: VT000099">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Tên Vật Liệu <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="createVl_TenVatLieu" maxlength="200">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Nhóm Vật Tư <span class="text-danger">*</span></label>
                        <select class="form-select" id="createVl_NhomVatLieu">
                            <option value="">-- Chọn nhóm --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Đơn Vị Tính <span class="text-danger">*</span></label>
                        <select class="form-select" id="createVl_DonViTinh">
                            <option value="">-- Chọn ĐVT --</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Đơn Giá (VNĐ) <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="createVl_DonGia" min="0" step="1" value="0">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Mức Tối Thiểu</label>
                        <input type="number" class="form-control" id="createVl_MucToiThieu" min="0" step="1" placeholder="Mặc định: 5">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Trạng Thái</label>
                        <select class="form-select" id="createVl_TrangThai">
                            <option value="Đang sử dụng" selected>Đang sử dụng</option>
                            <option value="Ngừng sử dụng">Ngừng sử dụng</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Mô Tả</label>
                        <textarea class="form-control" id="createVl_MoTa" rows="2"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-primary btn-sm" id="btnSaveCreateVatLieu" onclick="saveCreateVatLieu()">
                    <i class="bi bi-check-lg me-1"></i>Lưu
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══ MODAL: Kho (Create / Edit) ═══ -->
<div class="modal fade" id="khoModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="formKhoTitle">Thêm Kho Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="formKhoId">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Tên Kho <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="formTenKho" maxlength="200">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Địa Chỉ</label>
                    <input type="text" class="form-control" id="formDiaChiKho">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Ghi Chú</label>
                    <textarea class="form-control" id="formGhiChuKho" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-primary btn-sm" onclick="saveKho()">
                    <i class="bi bi-check-lg me-1"></i>Lưu
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══ MODAL: Thêm Vật Liệu Vào Kho ═══ -->
<div class="modal fade" id="addVatLieuKhoModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-box-seam me-2"></i>Thêm Vật Liệu Vào Kho:
                    <span id="addVlKhoTenKho" class="text-primary"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="addVlKhoId">
                <!-- Search -->
                <div class="mb-3">
                    <input type="text" class="form-control form-control-sm" id="addVlSearchInput"
                           placeholder="Tìm theo mã hoặc tên vật liệu...">
                </div>
                <!-- Select all -->
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="addVlSelectAll">
                    <label class="form-check-label fw-semibold" for="addVlSelectAll">Chọn tất cả (chưa có trong kho)</label>
                </div>
                <!-- Table -->
                <div class="table-responsive" style="max-height:400px;overflow-y:auto">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th style="width:40px" class="text-center"></th>
                                <th>Mã VL</th>
                                <th>Tên Vật Liệu</th>
                                <th>ĐVT</th>
                                <th style="width:80px" class="text-center">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody id="addVlTableBody">
                            <tr><td colspan="5" class="text-center text-muted py-4">Đang tải...</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="mt-2 text-muted small" id="addVlSummary"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-success btn-sm" id="btnSubmitAddVatLieu" onclick="submitAddVatLieuToKho()">
                    <i class="bi bi-plus-lg me-1"></i>Thêm vào kho
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══ MODAL: Chi Tiết Phiếu (EXACT copy from Kho) ═══ -->
