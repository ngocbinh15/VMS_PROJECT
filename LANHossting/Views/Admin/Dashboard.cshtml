                <input type="hidden" id="confirmTuChoiPhieuId">
                <div class="text-danger mb-3"><i class="bi bi-x-circle" style="font-size: 2.8rem;"></i></div>
                <h6 class="fw-bold" id="confirmTuChoiMaPhieuText">Từ chối phiếu giao dịch</h6>
                <p class="text-muted small mb-3">Nhập lý do từ chối phiếu giao dịch (tùy chọn):</p>
                <div class="text-start mb-1">
                    <textarea class="form-control shadow-none bg-light border-0" id="confirmTuChoiLyDoInput" rows="3" placeholder="VD: Dữ liệu không chính xác, thiếu chứng từ..." style="border-radius: 10px; font-size: 0.88rem;"></textarea>
                </div>
            </div>
            <div class="modal-footer border-top-0 justify-content-center pt-0 pb-4">
                <button type="button" class="btn btn-light fw-bold px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger fw-bold px-4" onclick="confirmTuChoiPhieuSubmit()">
